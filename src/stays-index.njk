---
layout: base.njk
permalink: /stays/
title: Stays
description: "Every place I have slept, browsable by what you want from it. Camping, hotels, rural boltholes, hot tubs, saunas, forest cabins, beaches and pools."
---
{% from "plate.njk" import img, card, tile, note %}
{% set heroPlate = atlas.types | findBySlug("hot-tub") | attr("plate") %}

<section class="hero hero--short">
  {{ img(heroPlate, "wide", true) }}
  <span class="hero__scrim"></span>
  {{ note(heroPlate) }}
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ atlas.totals.stays | pl("stay") }} · {{ atlas.totals.types | pl("type") }}</p>
    <h1 class="hero__title">Where to <em>sleep</em></h1>
    <p class="hero__lede">Browse by what you want out of a place rather than by which country it happens to be in.</p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">By type</p>
    <h2 class="sec__title">Pick your <em>kind</em> of night</h2>
  </div>
  <div class="tiles">
    {%- for t in atlas.types %}
    {{ tile(t.plate, t.url, t.name, t.stayCount | pl("stay") ~ " · from " ~ (t.fromPrice | money)) }}
    {%- endfor %}
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">All {{ atlas.totals.stays }}</p>
    <h2 class="sec__title">Everything, <em>best first</em></h2>
    <p class="sec__sub">Scored on one question: would I tell someone else to go?</p>
  </div>
  <div class="cards">
    {%- for s in atlas.stays | sortByRating %}
    {{ card(s.plate, s.url, s.placeName ~ ", " ~ s.countryName ~ " · " ~ (s.price | money), s.name, s.summary, "Read the review", s.rating) }}
    {%- endfor %}
  </div>
</section>
