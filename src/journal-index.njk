---
layout: base.njk
permalink: /journal/
title: Journal
description: Longer write-ups of individual trips, in the order they happened.
---
{% from "plate.njk" import img, card %}

<section class="hero hero--short">
  {{ img(atlas.places | findBySlug("orlando") | attr("plate"), "wide", true) }}
  <span class="hero__scrim"></span>
  <span class="hero__note">Drawn plate, not a photograph</span>
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ entries | length | pl("entry","entries") }}</p>
    <h1 class="hero__title">The <em>journal</em></h1>
    <p class="hero__lede">Single trips, at length, where a directory entry only gets a paragraph.</p>
  </div>
</section>

<section class="sec">
  <div class="cards">
    {%- for e in entries %}
    {%- set p = atlas.places | findBySlug(e.placeSlug) %}
    {{ card(p.plate, "/journal/" ~ e.slug ~ "/", e.month ~ " · " ~ e.country, e.place, e.kicker, "Read the entry", e.rating) }}
    {%- endfor %}
  </div>
</section>
