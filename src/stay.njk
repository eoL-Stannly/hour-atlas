---
layout: base.njk
pagination: { data: atlas.stays, size: 1, alias: s }
permalink: "/stays/{{ s.types[0] }}/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.name }}"
  description: "{{ s.summary }}"
  ogType: article
---
{% from "plate.njk" import img, card, note, gallery %}
{% set lbGroup = "stay-" ~ s.slug %}
{% set restOfGallery = s.gallery | rejectByKey(s.plate.key) %}

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/stays/">Stays</a>
  <a href="/stays/{{ s.primaryType }}/">{{ s.primaryTypeName }}</a>
  <span aria-current="page">{{ s.name }}</span>
</nav>

<header class="stayhead">
  <p class="kicker">{{ s.kind }} · {{ s.placeName }}, {{ s.countryName }}</p>
  <h1 class="stayhead__title">{{ s.name }}</h1>
  <p class="stayhead__lede">{{ s.summary }}</p>
</header>

<section class="stayshots">
  <div class="stayshots__hero">
    {{ img(s.plate, "wide", true, "100vw", true, lbGroup) }}
    {{ note(s.plate) }}
  </div>
  {%- if restOfGallery.length %}
  <div class="wrap">{{ gallery(restOfGallery, "sq", "(min-width:64rem) 30vw, 46vw", lbGroup) }}</div>
  {%- endif %}
</section>

<section class="sec">
  <dl class="facts">
    <div><dt>Score</dt><dd>{{ s.rating }} out of 5</dd></div>
    <div><dt>Stayed</dt><dd>{{ s.stayed }}, {{ s.nights }} {{ "night" if s.nights == 1 else "nights" }}</dd></div>
    <div><dt>Sleeps</dt><dd>{{ s.sleeps }}</dd></div>
    <div><dt>From</dt><dd>{{ s.price | money }} a night</dd></div>
    <div><dt>Where</dt><dd><a href="{{ s.placeUrl }}">{{ s.placeName }}</a>, <a href="{{ s.countryUrl }}">{{ s.countryName }}</a></dd></div>
  </dl>
  <ul class="tags">
    {%- for t in s.typeObjects %}
    <li><a class="tag{% if t.slug == s.primaryType %} tag--on{% endif %}" href="{{ t.url }}">{{ t.name }}</a></li>
    {%- endfor %}
  </ul>
</section>

<section class="sec" style="padding-top:0">
  <div class="prose prose--lead">
    {%- for para in s.review %}<p>{{ para }}</p>{% endfor %}
  </div>

  <div class="split">
    <div>
      <h2 class="kicker">What works</h2>
      <ul class="pts pts--good">{% for g in s.good %}<li>{{ g }}</li>{% endfor %}</ul>
    </div>
    <div>
      <h2 class="kicker">What does not</h2>
      <ul class="pts pts--bad">{% for b in s.bad %}<li>{{ b }}</li>{% endfor %}</ul>
    </div>
  </div>

  <div class="pullbox">
    <p class="kicker">The verdict</p>
    <p>{{ s.verdict }}</p>
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">Nearby</p>
    <h2 class="sec__title">More <em>{{ s.primaryTypeName | lower }}</em></h2>
  </div>
  <div class="cards">
    {%- for o in atlas.types | findBySlug(s.primaryType) | attr("stays") | sortByRating | limit(3) %}
    {%- if o.slug != s.slug %}
    {{ card(o.plate, o.url, o.placeName ~ ", " ~ o.countryName ~ " · " ~ (o.price | money), o.name, o.summary, "Read the review", o.rating) }}
    {%- endif %}{% endfor %}
  </div>
</section>

<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Stays","item":"{{ site.url }}/stays/"},{"@type":"ListItem","position":2,"name":"{{ s.primaryTypeName }}","item":"{{ site.url }}/stays/{{ s.primaryType }}/"},{"@type":"ListItem","position":3,"name":"{{ s.name }}","item":"{{ site.url }}{{ s.url }}"}]}</script>
