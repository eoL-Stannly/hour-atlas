---
layout: base.njk
pagination: { data: atlas.stays, size: 1, alias: s }
permalink: "/stays/{{ s.types[0] }}/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.name }}"
  description: "{{ s.summary }}"
  ogType: article
---
{% from "rec.njk" import rec %}

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/stays/">Stays</a>
  <a href="/stays/{{ s.primaryType }}/">{{ s.primaryTypeName }}</a>
  <span aria-current="page">{{ s.name }}</span>
</nav>

<header class="head">
  <p class="mini">{{ s.kind }} · <a class="tlink" href="{{ s.placeUrl }}">{{ s.placeName }}</a>, <a class="tlink" href="{{ s.countryUrl }}">{{ s.countryName }}</a></p>
  <h1 class="head__title">{{ s.name }}</h1>
  <p class="head__lede">{{ s.summary }}</p>
</header>

<section class="band">
  <div class="card">
    <p class="card__score"><span class="card__num">{{ s.rating }}</span><span class="card__den">/5</span></p>
    <dl class="card__facts">
      <div><dt>Stayed</dt><dd>{{ s.stayed }}, {{ s.nights }} {{ "night" if s.nights == 1 else "nights" }}</dd></div>
      <div><dt>Sleeps</dt><dd>{{ s.sleeps }}</dd></div>
      <div><dt>From</dt><dd>{{ s.price | money }} a night</dd></div>
      <div><dt>Filed under</dt><dd>{{ s.primaryTypeName }}</dd></div>
    </dl>
  </div>
  <ul class="tags">
    {%- for t in s.typeObjects %}
    <li><a class="tag{% if t.slug == s.primaryType %} tag--on{% endif %}" href="{{ t.url }}">{{ t.name }}</a></li>
    {%- endfor %}
  </ul>
</section>

<section class="band">
  <div class="prose">
    {%- for para in s.review %}<p>{{ para }}</p>{% endfor %}
  </div>
</section>

<section class="band">
  <div class="split">
    <div>
      <h2 class="mini">What works</h2>
      <ul class="pts pts--good">{% for g in s.good %}<li>{{ g }}</li>{% endfor %}</ul>
    </div>
    <div>
      <h2 class="mini">What does not</h2>
      <ul class="pts pts--bad">{% for b in s.bad %}<li>{{ b }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section class="band">
  <blockquote class="verdict">
    <p class="mini">The verdict</p>
    <p>{{ s.verdict }}</p>
  </blockquote>
</section>

<section class="band">
  <div class="band__head"><h2 class="band__title">Elsewhere in {{ s.placeName }}</h2></div>
  <div class="recs">
    {{ rec("All stays in " ~ s.placeName, s.placeUrl, s.countryName, "") }}
    {{ rec("More " ~ (s.primaryTypeName | lower), "/stays/" ~ s.primaryType ~ "/", "By type", "") }}
  </div>
</section>

<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Stays","item":"{{ site.url }}/stays/"},{"@type":"ListItem","position":2,"name":"{{ s.primaryTypeName }}","item":"{{ site.url }}/stays/{{ s.primaryType }}/"},{"@type":"ListItem","position":3,"name":"{{ s.name }}","item":"{{ site.url }}{{ s.url }}"}]}</script>
