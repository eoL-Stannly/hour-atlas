<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} · {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="stylesheet" href="{{ assets.css }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="en-gb" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">
<meta name="theme-color" content="#e8eae4">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23e8eae4'/><circle cx='8' cy='8' r='3.5' fill='%23c4006a'/></svg>">
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header class="bar">
  <a class="bar__mark" href="/">{{ site.name }}</a>
  <nav class="bar__nav" aria-label="Primary">
    <a href="/destinations/"{% if "/destinations/" in page.url %} aria-current="page"{% endif %}>Destinations</a>
    <a href="/stays/"{% if "/stays/" in page.url %} aria-current="page"{% endif %}>Stays</a>
    <a href="/journal/"{% if "/journal/" in page.url %} aria-current="page"{% endif %}>Journal</a>
    <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
  </nav>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__brand">
      <p class="foot__mark">{{ site.name }}</p>
      <p class="foot__line">{{ site.tagline }}</p>
    </div>
    <nav class="foot__col" aria-label="Regions">
      <h2 class="mini">Regions</h2>
      <ul>{% for r in atlas.regions %}<li><a href="{{ r.url }}">{{ r.name }}</a></li>{% endfor %}</ul>
    </nav>
    <nav class="foot__col" aria-label="Stay types">
      <h2 class="mini">Stay types</h2>
      <ul>{% for t in atlas.types %}<li><a href="{{ t.url }}">{{ t.name }}</a></li>{% endfor %}</ul>
    </nav>
    <nav class="foot__col" aria-label="More">
      <h2 class="mini">More</h2>
      <ul>
        <li><a href="/journal/">Journal</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul>
    </nav>
  </div>
  <p class="foot__note">
    Written by one person who paid for every night listed. No sponsorship, no affiliate links.
    Entries marked <em>placeholder</em> are unfinished and say so.
  </p>
</footer>

</body>
</html>
