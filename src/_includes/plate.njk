{% macro img(p, shape = "wide", eager = false, sizes = "100vw", lightbox = false, group = "g") %}
{%- if p %}{% set s = p[shape] %}
<img class="pl{% if lightbox %} pl--zoom{% endif %}" src="{{ s.src }}.webp"
     srcset="{{ s.src }}-sm.webp {{ s.sw }}w, {{ s.src }}.webp {{ s.w }}w"
     sizes="{{ sizes }}" width="{{ s.w }}" height="{{ s.h }}" alt="{{ p.alt }}"
     style="background-image:url({{ s.lqip }});background-size:cover"
     {% if lightbox %}data-lightbox="{{ group }}" data-full="{{ s.src }}.webp" data-caption="{{ p.caption }}" tabindex="0" role="button" aria-label="Expand photograph: {{ p.alt }}"{% endif %}
     {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
{%- endif %}
{% endmacro %}

{% macro stamp(score) %}
<span class="stamp" aria-label="Scored {{ score }} out of 5">
  <span class="stamp__n">{{ score }}</span><span class="stamp__d">/5</span>
</span>
{% endmacro %}

{% macro card(p, href, kicker, title, blurb, cta, score = 0, shape = "port") %}
<article class="card">
  <a class="card__img" href="{{ href }}">
    {{ img(p, shape, false, "(min-width:64rem) 30vw, (min-width:40rem) 45vw, 92vw") }}
    {%- if score %}{{ stamp(score) }}{% endif %}
  </a>
  <p class="kicker">{{ kicker }}</p>
  <h3 class="card__title"><a href="{{ href }}">{{ title }}</a></h3>
  {%- if blurb %}<p class="card__blurb">{{ blurb }}</p>{% endif %}
  <a class="cta" href="{{ href }}">{{ cta }}</a>
</article>
{% endmacro %}

{% macro tile(p, href, label, meta, shape = "sq") %}
<a class="tile" href="{{ href }}">
  {{ img(p, shape, false, "(min-width:64rem) 24vw, 46vw") }}
  <span class="tile__body">
    <span class="tile__label">{{ label }}</span>
    {%- if meta %}<span class="tile__meta">{{ meta }}</span>{% endif %}
  </span>
</a>
{% endmacro %}

{% macro note(p) %}
{%- if p and not p.photo %}<span class="hero__note">Drawn plate, not a photograph</span>{% endif %}
{% endmacro %}

{% macro gallery(items, shape = "sq", sizes = "(min-width:64rem) 30vw, 46vw", group = "g") %}
{%- if items and items.length %}
<div class="gal">
  {%- for g in items %}
  <figure class="gal__item">
    {{ img(g, shape, false, sizes, true, group) }}
    {%- if g.caption %}<figcaption class="gal__cap">{{ g.caption }}</figcaption>{% endif %}
  </figure>
  {%- endfor %}
</div>
{%- endif %}
{% endmacro %}
