---
layout: base.njk
permalink: /contact-sheet/
title: Contact sheet
description: Every frame published on the site, in one grid, with the place and exposure for each.
bodyClass: sheet
---
{% from "frame.njk" import frame %}

<section class="pagehead">
  <p class="label">Everything, unsorted by quality</p>
  <h1 class="pagehead__title">Contact sheet</h1>
  <p class="pagehead__lede">
    Every frame on the site in the order the entries run, numbered the way the
    camera numbered them. Click any of them to see it properly.
  </p>
</section>

<section class="sheet__grid">
  {%- for e in entries %}
    {%- for f in e.frameObjects %}
    <figure class="cell">
      <button class="cell__btn" type="button" data-ref="{{ f.ref }}" aria-label="Open {{ f.ref }}, {{ e.place }}">
        <span class="cell__box" style="--ratio: {{ f.ratio }}; background-image: url('{{ f.lqip }}')">
          <img class="frame__img" src="{{ f.fallback }}" srcset="{{ f.srcset }}" sizes="(min-width: 60rem) 24vw, 46vw"
               width="{{ f.w }}" height="{{ f.h }}" alt="{{ f.alt }}" data-ref="{{ f.ref }}" loading="lazy" decoding="async">
        </span>
      </button>
      <figcaption class="rebate">
        <span class="rebate__ref">{{ f.ref }}</span>
        <span class="rebate__note">{{ e.place }}{% if f.placeholder %} · plate{% endif %}</span>
      </figcaption>
    </figure>
    {%- endfor %}
  {%- endfor %}
</section>
