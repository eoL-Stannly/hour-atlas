---
layout: base.njk
pagination: { data: entries, size: 1, alias: e }
permalink: "/journal/{{ e.slug }}/"
eleventyComputed:
  title: "{{ e.place }}, {{ e.country }}"
  description: "{{ e.kicker }}"
  ogType: article
---
{% from "plate.njk" import img, card, gallery, note %}
{% set p = atlas.places | findBySlug(e.placeSlug) %}
{% set hero = e.plate or (p.plate if p) %}

<nav class="crumbs" aria-label="Breadcrumb"><a href="/journal/">Journal</a><span aria-current="page">{{ e.place }}</span></nav>

<section class="hero">
  {{ img(hero, "wide", true, "100vw", true, "journal-" ~ e.slug) }}
  <span class="hero__scrim"></span>
  {{ note(hero) }}
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ e.dates }} · {{ e.region }}, {{ e.country }}</p>
    <h1 class="hero__title">{{ e.place }}</h1>
    <p class="hero__lede">{{ e.kicker }}</p>
  </div>
</section>

<section class="sec">
  <dl class="facts">
    <div><dt>Score</dt><dd>{{ e.rating }} out of 5</dd></div>
    <div><dt>Went</dt><dd>{{ e.dates }}</dd></div>
    <div><dt>Again?</dt><dd>{{ e.again }}</dd></div>
    <div><dt>Where</dt><dd>{% if p %}<a href="{{ p.url }}">{{ p.name }}</a>, {{ p.countryName }}{% else %}{{ e.region }}, {{ e.country }}{% endif %}</dd></div>
  </dl>
</section>

<section class="sec" style="padding-top:0">
  <div class="prose prose--lead">
    {%- for para in e.body %}<p>{{ para }}</p>{% endfor %}
  </div>
  <div class="pullbox">
    <p class="kicker">The verdict</p>
    <p>{{ e.verdict }}</p>
  </div>
</section>

{%- if e.gallery.length %}
<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">{{ e.gallery.length }} photographs</p>
    <h2 class="sec__title">The <em>whole set</em></h2>
  </div>
  <div class="wrap">{{ gallery(e.gallery | rejectByKey(hero.key), "sq", "(min-width:64rem) 30vw, 46vw", "journal-" ~ e.slug) }}</div>
</section>
{%- endif %}

{%- if p and p.stays.length %}
<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">While you are there</p>
    <h2 class="sec__title">Where to <em>stay</em> in {{ p.name }}</h2>
  </div>
  <div class="cards">
    {%- for s in p.stays %}
    {{ card(s.plate, s.url, s.kind ~ " · " ~ (s.price | money), s.name, s.summary, "Read the review", s.rating) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}
