---
layout: base.njk
pagination: { data: entries, size: 1, alias: e }
permalink: "/journal/{{ e.slug }}/"
eleventyComputed:
  title: "{{ e.place }}, {{ e.country }}"
  description: "{{ e.kicker }}"
  ogType: article
---
{% from "rec.njk" import rec %}

<nav class="crumbs" aria-label="Breadcrumb"><a href="/journal/">Journal</a><span aria-current="page">{{ e.place }}</span></nav>

<header class="head">
  <p class="mini">{{ e.dates }} · {{ e.region }}, {{ e.country }}{% if e.placeholder %} · <span class="flag">Placeholder</span>{% endif %}</p>
  <h1 class="head__title">{{ e.place }}</h1>
  <p class="head__lede">{{ e.kicker }}</p>
</header>

<section class="band">
  <div class="prose prose--lead">
    {%- for para in e.body %}<p>{{ para }}</p>{% endfor %}
  </div>
</section>

<section class="band">
  <blockquote class="verdict">
    <p class="mini">The verdict · {{ e.rating }}/5 · would go again: {{ e.again | lower }}</p>
    <p>{{ e.verdict }}</p>
  </blockquote>
</section>

<section class="band">
  <div class="band__head"><h2 class="band__title">The directory entry</h2></div>
  <div class="recs">
    {%- for p in atlas.places %}{% if p.slug == e.placeSlug %}
    {{ rec(p.name, p.url, p.countryName, p.stayCount | pl("stay")) }}
    {%- endif %}{% endfor %}
  </div>
</section>
