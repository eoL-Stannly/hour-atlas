---
layout: base.njk
pagination: { data: atlas.types, size: 1, alias: t }
permalink: "/stays/{{ t.slug }}/"
eleventyComputed:
  title: "{{ t.name }}"
  description: "{{ t.blurb }}"
---
{% from "plate.njk" import img, card, tile %}

<nav class="crumbs" aria-label="Breadcrumb"><a href="/stays/">Stays</a><span aria-current="page">{{ t.name }}</span></nav>

<section class="hero hero--short">
  {{ img(t.plate, "wide", true) }}
  <span class="hero__scrim"></span>
  <span class="hero__note">Drawn plate, not a photograph</span>
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ t.stayCount | pl("stay") }}{% if t.fromPrice %} · from {{ t.fromPrice | money }} a night{% endif %}</p>
    <h1 class="hero__title">{{ t.name }}</h1>
    <p class="hero__lede">{{ t.blurb }}</p>
  </div>
</section>

<section class="sec">
  <div class="cards">
    {%- for s in t.stays | sortByRating %}
    {{ card(s.plate, s.url, s.placeName ~ ", " ~ s.countryName ~ " · " ~ (s.price | money), s.name, s.summary, "Read the review", s.rating) }}
    {%- endfor %}
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">Or try</p>
    <h2 class="sec__title">Another <em>kind</em> of night</h2>
  </div>
  <div class="tiles">
    {%- for o in atlas.types %}{% if o.slug != t.slug %}
    {{ tile(o.plate, o.url, o.name, o.stayCount | pl("stay")) }}
    {%- endif %}{% endfor %}
  </div>
</section>
