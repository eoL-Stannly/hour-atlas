---
layout: base.njk
pagination: { data: atlas.types, size: 1, alias: t }
permalink: "/stays/{{ t.slug }}/"
eleventyComputed:
  title: "{{ t.name }}"
  description: "{{ t.blurb }}"
---
{% from "rec.njk" import rec %}

<nav class="crumbs" aria-label="Breadcrumb"><a href="/stays/">Stays</a><span aria-current="page">{{ t.name }}</span></nav>

<header class="head">
  <p class="mini">{{ t.stayCount | pl("stay") }}{% if t.fromPrice %} · from {{ t.fromPrice | money }} a night{% endif %}</p>
  <h1 class="head__title">{{ t.name }}</h1>
  <p class="head__lede">{{ t.blurb }}</p>
</header>

<section class="band">
  <div class="recs">
    {%- for s in t.stays | sortByRating %}
    {{ rec(s.name, s.url, s.placeName ~ ", " ~ s.countryName, s.price | money, s.summary, s.rating ~ "/5") }}
    {%- endfor %}
  </div>
</section>

<section class="band">
  <div class="band__head"><h2 class="band__title">Other types</h2></div>
  <div class="recs">
    {%- for o in atlas.types %}{% if o.slug != t.slug %}
    {{ rec(o.name, o.url, o.stayCount | pl("stay"), "from " ~ (o.fromPrice | money)) }}
    {%- endif %}{% endfor %}
  </div>
</section>
