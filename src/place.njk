---
layout: base.njk
pagination: { data: atlas.places, size: 1, alias: p }
permalink: "/destinations/{{ p.regionSlug }}/{{ p.country }}/{{ p.slug }}/"
eleventyComputed:
  title: "{{ p.name }}, {{ p.countryName }}"
  description: "{{ p.blurb }}"
---
{% from "plate.njk" import img, card, tile, note, gallery %}

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/destinations/">Destinations</a>
  <a href="/destinations/{{ p.regionSlug }}/">{{ p.regionName }}</a>
  <a href="{{ p.countryUrl }}">{{ p.countryName }}</a>
  <span aria-current="page">{{ p.name }}</span>
</nav>

<section class="hero">
  {{ img(p.plate, "wide", true, "100vw", true, "place-" ~ p.slug) }}
  <span class="hero__scrim"></span>
  {{ note(p.plate) }}
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ p.kind }} · {{ p.countryName }}</p>
    <h1 class="hero__title">{{ p.name }}</h1>
    <p class="hero__lede">{{ p.blurb }}</p>
  </div>
</section>

<section class="sec">
  <dl class="facts">
    <div><dt>Getting there</dt><dd>{{ p.gettingThere }}</dd></div>
    <div><dt>Best time</dt><dd>{{ p.bestTime }}</dd></div>
    <div><dt>Stays</dt><dd>{% if p.fromPrice %}{{ p.stayCount | pl("stay") }}, from {{ p.fromPrice | money }} a night{% else %}None on file yet{% endif %}</dd></div>
  </dl>
</section>

{%- if p.gallery.length %}
<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">{{ p.gallery.length }} photographs</p>
    <h2 class="sec__title">{{ p.name }} <em>as it looks</em></h2>
  </div>
  <div class="wrap">{{ gallery(p.gallery | rejectByKey(p.plate.key), "sq", "(min-width:64rem) 30vw, 46vw", "place-" ~ p.slug) }}</div>
</section>
{%- endif %}

{%- if p.stays.length %}
<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">Reviewed</p>
    <h2 class="sec__title">Where to <em>stay</em> in {{ p.name }}</h2>
  </div>
  <div class="cards">
    {%- for s in p.stays %}
    {{ card(s.plate, s.url, s.kind ~ " · sleeps " ~ s.sleeps ~ " · " ~ (s.price | money), s.name, s.summary, "Read the review", s.rating) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if p.entries.length %}
<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">From the journal</p>
    <h2 class="sec__title">Written up at <em>length</em></h2>
  </div>
  <div class="cards cards--two">
    {%- for e in p.entries %}
    {{ card(p.plate, e.url, e.month, e.title, "The full account of this trip.", "Read the entry") }}
    {%- endfor %}
  </div>
</section>
{%- endif %}
