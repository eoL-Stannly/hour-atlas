---
layout: base.njk
pagination: { data: atlas.places, size: 1, alias: p }
permalink: "/destinations/{{ p.regionSlug }}/{{ p.country }}/{{ p.slug }}/"
eleventyComputed:
  title: "{{ p.name }}, {{ p.countryName }}"
  description: "{{ p.blurb }}"
---
{% from "rec.njk" import rec %}
{% from "plate.njk" import plate %}

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/destinations/">Destinations</a>
  <a href="/destinations/{{ p.regionSlug }}/">{{ p.regionName }}</a>
  <a href="{{ p.countryUrl }}">{{ p.countryName }}</a>
  <span aria-current="page">{{ p.name }}</span>
</nav>

<header class="head">
  <p class="mini">{{ p.kind }} · {{ p.countryName }}</p>
  <h1 class="head__title">{{ p.name }}</h1>
  <p class="head__lede">{{ p.blurb }}</p>
</header>

<section class="band">
  {{ plate(p.plate, true) }}
</section>

<section class="band">
  <dl class="facts facts--wide">
    <div><dt>Getting there</dt><dd>{{ p.gettingThere }}</dd></div>
    <div><dt>Best time</dt><dd>{{ p.bestTime }}</dd></div>
    <div><dt>Stays</dt><dd>{% if p.fromPrice %}{{ p.stayCount }}, from {{ p.fromPrice | money }} a night{% else %}None on file yet{% endif %}</dd></div>
  </dl>
</section>

{%- if p.entries.length %}
<section class="band">
  <div class="band__head"><h2 class="band__title">Written up</h2></div>
  <div class="recs">
    {%- for e in p.entries %}{{ rec(e.title, e.url, "Journal entry", e.month) }}{% endfor %}
  </div>
</section>
{%- endif %}

<section class="band">
  <div class="band__head">
    <h2 class="band__title">Where to stay in {{ p.name }}</h2>
    <p class="band__note">{{ p.stayCount | pl("stay") }} reviewed</p>
  </div>
  <div class="recs">
    {%- for s in p.stays %}
    {{ rec(s.name, s.url, s.kind ~ " · sleeps " ~ s.sleeps, s.price | money, s.summary, s.rating ~ "/5") }}
    {%- endfor %}
  </div>
</section>
