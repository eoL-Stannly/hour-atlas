---
layout: base.njk
pagination: { data: atlas.regions, size: 1, alias: r }
permalink: "/destinations/{{ r.slug }}/"
eleventyComputed:
  title: "{{ r.name }}"
  description: "{{ r.blurb }}"
---
{% from "rec.njk" import rec %}

<nav class="crumbs" aria-label="Breadcrumb"><a href="/destinations/">Destinations</a><span aria-current="page">{{ r.name }}</span></nav>

<header class="head">
  <p class="mini">{{ r.countryCount | pl("country","countries") }} · {{ r.placeCount | pl("place") }} · {{ r.stayCount | pl("stay") }}</p>
  <h1 class="head__title">{{ r.name }}</h1>
  <p class="head__lede">{{ r.blurb }}</p>
</header>

{%- for c in r.countries %}
<section class="band">
  <div class="band__head">
    <h2 class="band__title"><a class="tlink" href="{{ c.url }}">{{ c.name }}</a></h2>
    <p class="band__note">{{ c.blurb }}</p>
  </div>
  <dl class="facts">
    <div><dt>Population</dt><dd>{{ c.population }}</dd></div>
    <div><dt>Capital</dt><dd>{{ c.capital }}</dd></div>
    <div><dt>Getting there</dt><dd>{{ c.flight }}</dd></div>
    <div><dt>When to go</dt><dd>{{ c.whenToGo }}</dd></div>
  </dl>
  <div class="recs">
    {%- for p in c.places %}
    {{ rec(p.name, p.url, p.kind, (p.stayCount | pl("stay")) if p.stayCount else "No stays yet") }}
    {%- endfor %}
  </div>
</section>
{%- endfor %}
