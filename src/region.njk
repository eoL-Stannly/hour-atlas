---
layout: base.njk
pagination: { data: atlas.regions, size: 1, alias: r }
permalink: "/destinations/{{ r.slug }}/"
eleventyComputed:
  title: "{{ r.name }}"
  description: "{{ r.blurb }}"
---
{% from "plate.njk" import img, card, tile %}

<nav class="crumbs" aria-label="Breadcrumb"><a href="/destinations/">Destinations</a><span aria-current="page">{{ r.name }}</span></nav>

<section class="hero hero--short">
  {{ img(r.countries[0].plate, "wide", true) }}
  <span class="hero__scrim"></span>
  <span class="hero__note">Drawn plate, not a photograph</span>
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ r.countryCount | pl("country","countries") }} · {{ r.placeCount | pl("place") }} · {{ r.stayCount | pl("stay") }}</p>
    <h1 class="hero__title">{{ r.name }}</h1>
    <p class="hero__lede">{{ r.blurb }}</p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">Countries</p>
    <h2 class="sec__title">Everywhere in <em>{{ r.name }}</em></h2>
  </div>
  <div class="cards">
    {%- for c in r.countries %}
    {{ card(c.plate, c.url, c.population ~ " people · " ~ c.capital, c.name, c.blurb, "Explore " ~ c.name) }}
    {%- endfor %}
  </div>
</section>
