---
layout: base.njk
bodyClass: home
---
{% from "frame.njk" import frame %}
{% set newest = entries[0] %}

<section class="opening">
  <div class="opening__photo">
    {{ frame(newest.leadFrame, "100vw", "frame--bleed", true, false) }}
  </div>
  <div class="opening__text">
    <p class="opening__eyebrow"><span class="rebate__ref">{{ newest.leadFrame.ref }}</span> {{ newest.place }}, {{ newest.country }}</p>
    <h1 class="opening__title"><span class="line"><span>Photographs</span></span><span class="line"><span>from the road,</span></span><span class="line"><span>and what I</span></span><span class="line"><span>actually thought.</span></span></h1>
    <p class="opening__cue">Scroll</p>
  </div>
</section>

<section class="intro">
  <p class="intro__lede" data-reveal>
    I take a camera everywhere and I am not a good enough photographer to
    pretend the pictures are the whole story. So each entry here is a set of
    frames from one place, and an honest account of whether it was worth going.
    Some of it is not flattering.
  </p>
  <dl class="intro__meta" data-reveal>
    <div><dt>Kit</dt><dd>{{ site.gear }}</dd></div>
    <div><dt>Entries</dt><dd>{{ entries | length }}</dd></div>
    <div><dt>Frames published</dt><dd>{{ frames | length }}</dd></div>
  </dl>
</section>

{%- for e in entries %}
<article class="card" id="{{ e.slug }}">
  <header class="card__head">
    <p class="card__index">
      <span class="rebate__ref">{{ e.number }}</span>
      <span>{{ e.month }}</span>
      {%- if e.placeholder %}<span class="tag">Placeholder</span>{% endif %}
    </p>
    <h2 class="card__title"><a href="/journal/{{ e.slug }}/">{{ e.place }}</a></h2>
    <p class="card__where">{{ e.region }}, {{ e.country }}</p>
  </header>

  <div class="card__lead">
    {{ frame(e.leadFrame, "(min-width: 60rem) 62vw, 100vw", "frame--lead") }}
  </div>

  <div class="card__aside">
    <p class="card__kicker">{{ e.kicker }}</p>
    <p class="card__verdict">{{ e.verdict }}</p>
    <dl class="score">
      <div><dt>Verdict</dt><dd><span class="score__bar" data-score="{{ e.rating }}" aria-hidden="true"></span> <span class="mono">{{ e.rating }}/5</span></dd></div>
      <div><dt>Again?</dt><dd>{{ e.again }}</dd></div>
      {%- if e.stayed %}<div><dt>Stayed</dt><dd>{{ e.stayed.name }}, {{ e.stayed.type | lower }}</dd></div>{% endif %}
    </dl>
    <a class="more" href="/journal/{{ e.slug }}/">
      <span>Read the entry</span>
      <span class="mono">{{ e.frameObjects | length }} frames</span>
    </a>
  </div>

  {%- if e.frameObjects | length > 1 %}
  <div class="card__strip" data-reveal-group>
    {%- for f in e.frameObjects %}
      {%- if f.ref != e.lead %}
      {{ frame(f, "(min-width: 60rem) 30vw, 45vw", "frame--strip") }}
      {%- endif %}
    {%- endfor %}
  </div>
  {%- endif %}
</article>
{%- endfor %}

<section class="closing">
  <p class="label" data-reveal>Everything at once</p>
  <a class="closing__link" href="/contact-sheet/" data-reveal>
    <span class="closing__name">The contact sheet</span>
    <span class="mono">{{ frames | length }} frames</span>
  </a>
</section>
