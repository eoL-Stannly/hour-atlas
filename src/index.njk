---
layout: base.njk
---
{% from "plate.njk" import img, card, tile, stamp %}
{% set best = atlas.stays | sortByRating %}
{% set opener = atlas.places | findBySlug("cornwall") %}

<section class="hero">
  {{ img(opener.plate, "wide", true) }}
  <span class="hero__scrim"></span>
  <span class="hero__note">Drawn plate, not a photograph</span>
  <div class="hero__body">
    <p class="kicker hero__kicker">Ali Cook's travel journal</p>
    <h1 class="hero__title">Places worth <em>going to</em>, and places worth sleeping in.</h1>
    <p class="hero__lede">
      {{ atlas.totals.countries }} countries, {{ atlas.totals.places }} places
      and {{ atlas.totals.stays }} beds, every one paid for and scored out of
      five by somebody with no reason to be polite about it.
    </p>
    <p class="hero__cta">
      <a class="btn" href="/destinations/">Start exploring</a>
      <a class="btn btn--ghost" href="/about/">About me</a>
    </p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">Featured</p>
    <h2 class="sec__title">The <em>very best</em> of the file</h2>
    <p class="sec__sub">Three places I would send anyone to without a second thought.</p>
  </div>
  <div class="cards">
    {%- for s in best | limit(3) %}
    {{ card(s.plate, s.url, s.placeName ~ ", " ~ s.countryName, s.name, s.summary, "Read the review", s.rating) }}
    {%- endfor %}
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">Browse</p>
    <h2 class="sec__title">What do you want <em>out of it?</em></h2>
    <p class="sec__sub">A hot tub in the rain and a tent on a lake shore are not the same holiday.</p>
  </div>
  <div class="tiles">
    {%- for t in atlas.types %}
    {{ tile(t.plate, t.url, t.name, t.stayCount | pl("stay") ~ " · from " ~ (t.fromPrice | money)) }}
    {%- endfor %}
  </div>
</section>

<section class="sec">
  <div class="duo">
    <div>{{ img(atlas.places | findBySlug("lofoten") | attr("plate"), "port", false, "(min-width:64rem) 38vw, 92vw") }}</div>
    <div class="duo__text">
      <p class="kicker">About</p>
      <h2 class="sec__title">Hi, I'm <em>Ali</em></h2>
      <p class="sec__sub">
        I pay for every night I write about, take nothing from anybody, and
        score places out of five on one question only: would I tell someone
        else to go? That is why some of the write-ups are lukewarm.
      </p>
      <a class="cta" href="/about/">Read the full story</a>
    </div>
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">Where to</p>
    <h2 class="sec__title">Browse by <em>continent</em></h2>
  </div>
  <div class="tiles">
    {%- for r in atlas.regions %}
    {{ tile(r.countries[0].plate, r.url, r.name, r.countryCount | pl("country", "countries") ~ " · " ~ (r.placeCount | pl("place"))) }}
    {%- endfor %}
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">From the journal</p>
    <h2 class="sec__title">Longer <em>write-ups</em></h2>
    <p class="sec__sub">Single trips, at length, where a directory entry only gets a paragraph.</p>
  </div>
  <div class="cards">
    {%- for e in entries | limit(3) %}
    {%- set p = atlas.places | findBySlug(e.placeSlug) %}
    {{ card(p.plate, "/journal/" ~ e.slug ~ "/", e.month ~ " · " ~ e.country, e.place, e.kicker, "Read the entry") }}
    {%- endfor %}
  </div>
  <p class="notice"><a class="cta" href="/journal/">All {{ entries | length }} entries</a></p>
</section>

<section class="sec sec--deep">
  <div class="signup">
    <p class="kicker">No spam, no sponsors</p>
    <h2 class="sec__title">Get the <em>next one</em> first</h2>
    <p class="sec__sub">One email when a new place goes up. Nothing else, ever.</p>
    <form class="signup__form" name="subscribe" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/">
      <input type="hidden" name="form-name" value="subscribe">
      <p class="signup__hp"><label>Leave this empty <input name="bot-field"></label></p>
      <label class="signup__hp" for="email">Email address</label>
      <input id="email" type="email" name="email" placeholder="you@example.com" required>
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <p class="signup__small">Unsubscribe in one click. Your address goes nowhere else.</p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">Recently added</p>
    <h2 class="sec__title">The <em>latest</em> places on file</h2>
  </div>
  <div class="tiles">
    {%- for p in atlas.places | limit(8) %}
    {{ tile(p.plate, p.url, p.name, p.countryName) }}
    {%- endfor %}
  </div>
</section>
