---
layout: base.njk
---
{% from "plate.njk" import img, card %}
{% set heroPhoto = media["boathouse-deck-dusk"] %}
{% set stayA = atlas.stays | findBySlug("villa-helidona") %}
{% set stayB = atlas.stays | findBySlug("the-boathouse-norfolk") %}
{% set placeA = atlas.places | findBySlug("nydri") %}
{% set duoPhoto = media["lefkada-cove"] %}
{% set latest = entries | findBySlug("the-boathouse") %}

<section class="hero">
  {{ img(heroPhoto, "wide", true) }}
  <span class="hero__scrim"></span>
  <div class="hero__body">
    <p class="kicker hero__kicker">Ali Cook's travel journal</p>
    <h1 class="hero__title">Places worth <em>going to</em>, and places worth sleeping in.</h1>
    <p class="hero__lede">
      {{ atlas.totals.countries }} countries, {{ atlas.totals.places }} places
      and {{ atlas.totals.stays }} beds, every one paid for and scored out of
      five by somebody with no reason to be polite about it.
    </p>
    <p class="hero__cta">
      <a class="btn" href="/destinations/">Start exploring</a>
      <a class="btn btn--ghost" href="/about/">About me</a>
    </p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">Just added</p>
    <h2 class="sec__title">Two places I have <em>actually stayed</em></h2>
    <p class="sec__sub">The two newest reviews on the site, photographed rather than illustrated.</p>
  </div>
  <div class="cards cards--two">
    {{ card(stayB.plate, stayB.url, stayB.placeName ~ ", " ~ stayB.countryName ~ " · " ~ (stayB.price | money), stayB.name, stayB.summary, "Read the review", stayB.rating) }}
    {{ card(stayA.plate, stayA.url, stayA.placeName ~ ", " ~ stayA.countryName ~ " · " ~ (stayA.price | money), stayA.name, stayA.summary, "Read the review", stayA.rating) }}
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">Browse</p>
    <h2 class="sec__title">What do you want <em>out of it?</em></h2>
    <p class="sec__sub">A hot tub in the rain and a tent on a lake shore are not the same holiday.</p>
  </div>
  <ul class="linkrow">
    {%- for t in atlas.types %}
    <li><a href="{{ t.url }}">{{ t.name }} <span class="mono">{{ t.stayCount }}</span></a></li>
    {%- endfor %}
  </ul>
</section>

<section class="sec">
  <div class="duo">
    <div>{{ img(duoPhoto, "port", false, "(min-width:64rem) 38vw, 92vw") }}</div>
    <div class="duo__text">
      <p class="kicker">About</p>
      <h2 class="sec__title">Hi, I'm <em>Ali</em></h2>
      <p class="sec__sub">
        I pay for every night I write about, take nothing from anybody, and
        score places out of five on one question only: would I tell someone
        else to go? That is why some of the write-ups are lukewarm.
      </p>
      <a class="cta" href="/about/">Read the full story</a>
    </div>
  </div>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">Where to</p>
    <h2 class="sec__title">Browse by <em>continent</em></h2>
  </div>
  <ul class="linkrow">
    {%- for r in atlas.regions %}
    <li><a href="{{ r.url }}">{{ r.name }} <span class="mono">{{ r.countryCount }}</span></a></li>
    {%- endfor %}
  </ul>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">From the journal</p>
    <h2 class="sec__title">The <em>latest</em> write-up</h2>
    <p class="sec__sub">Single trips, at length, where a directory entry only gets a paragraph.</p>
  </div>
  <div class="cards cards--one">
    {{ card(latest.plate, "/journal/" ~ latest.slug ~ "/", latest.month ~ " · " ~ latest.country, latest.place, latest.kicker, "Read the entry", latest.rating) }}
  </div>
  <p class="notice"><a class="cta" href="/journal/">All {{ entries | length }} entries</a></p>
</section>

<section class="sec sec--deep">
  <div class="signup">
    <p class="kicker">No spam, no sponsors</p>
    <h2 class="sec__title">Get the <em>next one</em> first</h2>
    <p class="sec__sub">One email when a new place goes up. Nothing else, ever.</p>
    <form class="signup__form" name="subscribe" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/">
      <input type="hidden" name="form-name" value="subscribe">
      <p class="signup__hp"><label>Leave this empty <input name="bot-field"></label></p>
      <label class="signup__hp" for="email">Email address</label>
      <input id="email" type="email" name="email" placeholder="you@example.com" required>
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <p class="signup__small">Unsubscribe in one click. Your address goes nowhere else.</p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">Everywhere on file</p>
    <h2 class="sec__title">Or see <em>the whole map</em></h2>
    <p class="sec__sub">Everything else on the site, drawn plates included, lives one click further in.</p>
    <p class="hero__cta" style="justify-content:center;margin-top:1.4rem">
      <a class="btn" href="/destinations/">All destinations</a>
      <a class="btn btn--ghost" style="border-color:var(--sea);color:var(--sea)" href="/stays/">All stays</a>
    </p>
  </div>
</section>
