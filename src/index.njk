---
layout: base.njk
---
{% from "rec.njk" import rec %}

<section class="thesis">
  <h1 class="thesis__title">Places worth<br><em>going to.</em></h1>
  <p class="thesis__lede">
    {{ atlas.totals.countries }} countries, {{ atlas.totals.places }} places and
    {{ atlas.totals.stays }} places to sleep, each one written up by somebody who
    paid for the night and has no reason to be polite about it.
  </p>
  <dl class="tally">
    <div><dt>Regions</dt><dd>{{ atlas.totals.regions }}</dd></div>
    <div><dt>Countries</dt><dd>{{ atlas.totals.countries }}</dd></div>
    <div><dt>Places</dt><dd>{{ atlas.totals.places }}</dd></div>
    <div><dt>Stays</dt><dd>{{ atlas.totals.stays }}</dd></div>
    <div><dt>Written up</dt><dd>{{ entries | length }}</dd></div>
  </dl>
</section>

<section class="band">
  <div class="band__head">
    <h2 class="band__title">Best of the file</h2>
    <p class="band__note">Everything scored five out of five.</p>
  </div>
  <div class="recs">
    {%- for s in atlas.stays %}{% if s.rating == 5 %}
    {{ rec(s.name, s.url, s.primaryTypeName ~ " · " ~ s.placeName, s.price | money, "", s.rating ~ "/5") }}
    {%- endif %}{% endfor %}
  </div>
</section>

<section class="band">
  <div class="band__head">
    <h2 class="band__title">By where it is</h2>
    <p class="band__note"><a class="tlink" href="/destinations/">All destinations</a></p>
  </div>
  <div class="recs">
    {%- for r in atlas.regions %}
    {{ rec(r.name, r.url, r.countryCount | pl("country","countries"), r.stayCount | pl("stay")) }}
    {%- endfor %}
  </div>
</section>

<section class="band">
  <div class="band__head">
    <h2 class="band__title">By what you want from it</h2>
    <p class="band__note"><a class="tlink" href="/stays/">All stays</a></p>
  </div>
  <div class="recs">
    {%- for t in atlas.types %}
    {{ rec(t.name, t.url, t.stayCount | pl("stay"), "from " ~ (t.fromPrice | money)) }}
    {%- endfor %}
  </div>
</section>

<section class="band">
  <div class="band__head">
    <h2 class="band__title">Written up at length</h2>
    <p class="band__note"><a class="tlink" href="/journal/">All journal entries</a></p>
  </div>
  <div class="recs">
    {%- for e in entries %}
    {{ rec(e.place, "/journal/" ~ e.slug ~ "/", e.country, e.month, "", "Placeholder" if e.placeholder else "") }}
    {%- endfor %}
  </div>
</section>
