---
layout: base.njk
pagination: { data: atlas.countries, size: 1, alias: c }
permalink: "/destinations/{{ c.region }}/{{ c.slug }}/"
eleventyComputed:
  title: "{{ c.name }}"
  description: "{{ c.blurb }}"
---
{% from "rec.njk" import rec %}
{% from "plate.njk" import plate %}

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/destinations/">Destinations</a>
  <a href="/destinations/{{ c.regionSlug }}/">{{ c.regionName }}</a>
  <span aria-current="page">{{ c.name }}</span>
</nav>

<header class="head">
  <p class="mini">{{ c.regionName }}</p>
  <h1 class="head__title">{{ c.name }}</h1>
  <p class="head__lede">{{ c.blurb }}</p>
</header>

<section class="band">
  {{ plate(c.plate, true) }}
</section>

<section class="band">
  <div class="band__head"><h2 class="band__title">The country in eight lines</h2></div>
  <dl class="facts facts--wide">
    <div><dt>Population</dt><dd>{{ c.population }}</dd></div>
    <div><dt>Capital</dt><dd>{{ c.capital }}</dd></div>
    <div><dt>Currency</dt><dd>{{ c.currency }}</dd></div>
    <div><dt>Language</dt><dd>{{ c.language }}</dd></div>
    <div><dt>Time zone</dt><dd>{{ c.timezone }}</dd></div>
    <div><dt>Getting there</dt><dd>{{ c.flight }}</dd></div>
    <div><dt>When to go</dt><dd>{{ c.whenToGo }}</dd></div>
    <div><dt>On file</dt><dd>{{ c.placeCount | pl("place") }}, {{ c.stayCount | pl("stay") }}</dd></div>
  </dl>
  <p class="footnote">Population is a rounded 2024 estimate, kept for scale rather than precision.</p>
</section>

<section class="band">
  <div class="band__head">
    <h2 class="band__title">Places in {{ c.name }}</h2>
    <p class="band__note">{{ c.placeCount | pl("place") }} on file</p>
  </div>
  <div class="recs">
    {%- for p in c.places %}
    {{ rec(p.name, p.url, p.kind, (p.stayCount | pl("stay")) if p.stayCount else "No stays yet", p.blurb) }}
    {%- endfor %}
  </div>
</section>
