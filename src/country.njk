---
layout: base.njk
pagination: { data: atlas.countries, size: 1, alias: c }
permalink: "/destinations/{{ c.region }}/{{ c.slug }}/"
eleventyComputed:
  title: "{{ c.name }}"
  description: "{{ c.blurb }}"
---
{% from "plate.njk" import img, card, tile %}

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/destinations/">Destinations</a>
  <a href="/destinations/{{ c.regionSlug }}/">{{ c.regionName }}</a>
  <span aria-current="page">{{ c.name }}</span>
</nav>

<section class="hero hero--short">
  {{ img(c.plate, "wide", true) }}
  <span class="hero__scrim"></span>
  <span class="hero__note">Drawn plate, not a photograph</span>
  <div class="hero__body">
    <p class="kicker hero__kicker">{{ c.regionName }}</p>
    <h1 class="hero__title">{{ c.name }}</h1>
    <p class="hero__lede">{{ c.blurb }}</p>
  </div>
</section>

<section class="sec">
  <div class="sec__head sec__head--center">
    <p class="kicker">The basics</p>
    <h2 class="sec__title">{{ c.name }} in <em>eight lines</em></h2>
  </div>
  <dl class="facts">
    <div><dt>Population</dt><dd>{{ c.population }}</dd></div>
    <div><dt>Capital</dt><dd>{{ c.capital }}</dd></div>
    <div><dt>Currency</dt><dd>{{ c.currency }}</dd></div>
    <div><dt>Language</dt><dd>{{ c.language }}</dd></div>
    <div><dt>Time zone</dt><dd>{{ c.timezone }}</dd></div>
    <div><dt>Getting there</dt><dd>{{ c.flight }}</dd></div>
    <div><dt>When to go</dt><dd>{{ c.whenToGo }}</dd></div>
    <div><dt>On file</dt><dd>{{ c.placeCount | pl("place") }}, {{ c.stayCount | pl("stay") }}</dd></div>
  </dl>
  <p class="notice">Population is a rounded 2024 estimate, kept for scale rather than precision.</p>
</section>

<section class="sec sec--tint">
  <div class="sec__head sec__head--center">
    <p class="kicker">{{ c.placeCount | pl("place") }}</p>
    <h2 class="sec__title">Where to go in <em>{{ c.name }}</em></h2>
  </div>
  <div class="cards">
    {%- for p in c.places %}
    {{ card(p.plate, p.url, p.kind ~ (" · from " ~ (p.fromPrice | money) if p.fromPrice else ""), p.name, p.blurb, "See " ~ p.name) }}
    {%- endfor %}
  </div>
</section>
