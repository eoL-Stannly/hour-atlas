---
layout: base.njk
pagination:
  data: destinations
  size: 1
  alias: d
permalink: "/destinations/{{ d.slug }}/"
eleventyComputed:
  title: "{{ d.name }}, {{ d.country }}"
  description: "{{ d.kicker }} Where to stay in {{ d.name }}, filed under {{ d.time }}."
  bodyClass: "detail"
---

<section class="pagehead">
  <p class="place__meta">
    <strong>{{ d.time }}</strong>
    <span>{{ d.light }}</span>
    <span class="mono">{{ d.coords }}</span>
  </p>
  <h1 class="pagehead__title">{{ d.name }}<span class="place__country">{{ d.country }}</span></h1>
  <p class="place__kicker">{{ d.kicker }}</p>
</section>

<div class="horizon horizon--page" aria-hidden="true">
  <svg class="horizon__far" viewBox="0 0 1440 400" preserveAspectRatio="none">
    <path d="{{ d.horizon.far }}"/>
  </svg>
  <svg class="horizon__near" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice">
    {{ d.horizon.near | safe }}
  </svg>
</div>

<section class="section">
  <div class="place__detail">
    <div data-reveal>
      <p class="place__body">{{ d.body }}</p>
      <dl class="facts">
        <div class="facts__row"><dt>Go</dt><dd>{{ d.season }}</dd></div>
        <div class="facts__row"><dt>Getting there</dt><dd>{{ d.flight }}</dd></div>
        <div class="facts__row"><dt>Light</dt><dd>{{ d.light }}, {{ d.time }} local</dd></div>
        <div class="facts__row"><dt>Position</dt><dd class="mono">{{ d.coords }}</dd></div>
      </dl>
    </div>

    <div>
      <p class="label">Where to stay</p>
      <div class="stays" data-reveal-group>
        {%- for s in d.stays %}
        <div class="stay" id="{{ s.name | slug }}">
          <span class="stay__head">
            <span class="stay__type">{{ s.type }}</span>
            <span>Sleeps {{ s.sleeps }}</span>
          </span>
          <h2 class="stay__name">{{ s.name }}</h2>
          <p class="stay__note">{{ s.note }}</p>
          <span class="stay__price"><b>{{ s.price | money }}</b> <span>per night</span></span>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>

<section class="nextup">
  <p class="label" data-reveal>
    {%- if pagination.nextPageLink %}Next hour{% else %}Back to the top of the day{% endif %}
  </p>
  <a href="{% if pagination.nextPageLink %}{{ pagination.nextPageLink }}{% else %}/{% endif %}" data-reveal>
    <span class="nextup__name">
      {%- if pagination.href.next %}{{ destinations[pagination.pageNumber + 1].name }}{% else %}Hour Atlas{% endif %}
    </span>
  </a>
</section>
