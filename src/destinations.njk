---
layout: base.njk
permalink: /destinations/
title: Destinations
description: Every country and place on the site, filed by region, with population, currency, flight times and when to go.
---
{% from "rec.njk" import rec %}

<header class="head">
  <p class="mini">{{ atlas.totals.regions | pl("region") }} · {{ atlas.totals.countries | pl("country","countries") }} · {{ atlas.totals.places | pl("place") }}</p>
  <h1 class="head__title">Destinations</h1>
  <p class="head__lede">Sorted by where things are rather than when I went. Pick a region, then a country, then a place.</p>
</header>

{%- for r in atlas.regions %}
<section class="band">
  <div class="band__head">
    <h2 class="band__title"><a class="tlink" href="{{ r.url }}">{{ r.name }}</a></h2>
    <p class="band__note">{{ r.blurb }}</p>
  </div>
  <div class="recs">
    {%- for c in r.countries %}
    {{ rec(c.name, c.url, c.population ~ " people", c.placeCount | pl("place")) }}
    {%- endfor %}
  </div>
</section>
{%- endfor %}
